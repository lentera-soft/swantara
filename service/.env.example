APP_NAME="Swantara API"
APP_HOST="localhost"
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_VERSION=dev
APP_PORT=8080
APP_PREFORK=false
APP_TRUSTED_PROXIES=
CLIENT_WEB_URL=http://localhost:3000

# --- Production overrides (self-hosting) ---
# APP_URL=https://erp.example.com
# CLIENT_WEB_URL=https://erp.example.com
# DB_SSL_MODE=require
# STORAGE_PATH=/app/storage
# APP_TRUSTED_PROXIES=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_ENCRYPTION=tls
# SMTP_FROM_EMAIL=noreply@erp.example.com
# MAIL_USER_VERIFICATION_REDIRECTION=https://erp.example.com/email-verify
# MAIL_PASSWORD_RESET_REDIRECTION=https://erp.example.com/password-reset

LOG_LEVEL=info
LOG_FILE=
LOG_FORMAT=pretty
LOG_MAX_SIZE=100
LOG_MAX_AGE=30
LOG_MAX_BACKUPS=3
LOG_COMPRESS=false

DB_NAME=swantara
DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_REQUIRE_NON_SUPERUSER=false
DB_SSL_MODE=disable
DB_CONNECTION_STRING=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

GOOSE_DRIVER=postgres
GOOSE_DBSTRING=${DB_CONNECTION_STRING}
GOOSE_MIGRATION_DIR=./migrations
GOOSE_TABLE=goose_migrations

BCRYPT_PASSWORD_COST=12
PASSWORD_PEPPER=

# Generate strong secrets for production: openssl rand -base64 32
JWT_ACCESS_TOKEN_SECRET=swantara_local_dev
JWT_ACCESS_TOKEN_EXPIRES_IN=30m
JWT_REFRESH_TOKEN_SECRET=your-refresh-secret
JWT_REFRESH_TOKEN_EXPIRES_IN=48h
AUTH_EMAIL_VERIFY_TTL=24h
AUTH_PASSWORD_RESET_TTL=30m

# --- OAuth (leave empty to disable a provider) ---
# Google: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: ${APP_URL}/api/v1/auth/oauth/google/callback
# Facebook: https://developers.facebook.com/apps
#   Valid OAuth Redirect URIs: ${APP_URL}/api/v1/auth/oauth/facebook/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_FACEBOOK_APP_ID=
OAUTH_FACEBOOK_APP_SECRET=
OAUTH_STATE_TTL=10m
OAUTH_HTTP_TIMEOUT=15s
# In-app path the browser is redirected to after a successful OAuth login.
OAUTH_SUCCESS_REDIRECT=/onboarding

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=none
SMTP_FROM_EMAIL=noreply@swantara.com
SMTP_FROM_NAME={{APP_NAME}}

MAIL_USER_VERIFICATION_REDIRECTION=http://localhost:3000/email-verify
MAIL_PASSWORD_RESET_REDIRECTION=http://localhost:3000/password-reset

QUEUE_REDIS_HOST=localhost
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=
QUEUE_REDIS_DB=0

STORAGE_PROVIDER=local
STORAGE_PATH=./storage
STORAGE_MAX_UPLOAD_SIZE=10485760

# --- RustFS / S3-compatible object storage ---
# STORAGE_PROVIDER=rustfs
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_BUCKET=swantara
# STORAGE_ACCESS_KEY=rustfsadmin
# STORAGE_SECRET_KEY=rustfsadmin
# STORAGE_REGION=us-east-1
# STORAGE_USE_PATH_STYLE=true

RATE_LIMITER_ENABLED=true
RATE_LIMITER_MAX=60
RATE_LIMITER_EXPIRATION=1m
RATE_LIMITER_STORAGE=memory
RATE_LIMITER_REDIS_HOST=localhost
RATE_LIMITER_REDIS_PORT=6379
RATE_LIMITER_REDIS_PASSWORD=
RATE_LIMITER_REDIS_DB=0
